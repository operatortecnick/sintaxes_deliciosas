# API Extractor Configuration
# Copy this file to .env and fill in your API keys

# Stock Market APIs (optional - Yahoo Finance works without keys)
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here
FINNHUB_KEY=your_finnhub_key_here

# AI APIs (optional - some have free tiers without keys)
HUGGINGFACE_KEY=your_huggingface_key_here
OPENROUTER_KEY=your_openrouter_key_here
TOGETHER_KEY=your_together_key_here

# Rate limiting settings
REQUESTS_PER_MINUTE=60
RETRY_ATTEMPTS=3

# API Key Instructions:
#
# FREE APIs (no key required):
# - Yahoo Finance: Works immediately, no signup needed
# - Hugging Face Inference: Limited without key, but works
# - OpenRouter: Some free models available without key
#
# FREE API Keys (signup required):
# - Alpha Vantage: https://www.alphavantage.co/support/#api-key (500 requests/day free)
# - Finnhub: https://finnhub.io/register (60 calls/minute free)
# - Hugging Face: https://huggingface.co/settings/tokens (more models with key)
# - OpenRouter: https://openrouter.ai/keys (credits given on signup)
# - Together AI: https://api.together.xyz/signup (trial credits available)